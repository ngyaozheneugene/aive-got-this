{
  "name": "aive-got-this",
  "version": "0.5.0",
  "private": true,
  "description": "Dispatch Coordinator — agent-assisted recovery for a Singapore HVAC field-service day",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start:local": "bash scripts/run.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:g": "vitest run --dir evals/g-suite",
    "test:a": "vitest run --dir evals/a-suite",
    "test:x": "vitest run --dir evals/x-suite",
    "test:unit": "vitest run --dir src",
    "test:pg": "RUN_POSTGRES_TESTS=1 vitest run src/db/postgres",
    "db:up": "docker compose up -d postgres optimizer",
    "db:down": "docker compose down",
    "deploy:up": "docker compose up -d --build",
    "deploy:logs": "docker compose logs -f app",
    "docx": "python build/build_docx.py"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "postcss": "^8.5.28",
    "postgres": "^3.4.5",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
