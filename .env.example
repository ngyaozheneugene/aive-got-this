# Copy to .env. Do not commit real keys.

# In-memory by default, so the desk runs with no Docker. The product store is
# Postgres: run `npm run db:up` and set USE_MEMORY_DB=false. It migrates and
# seeds itself on first use. Set false on the Lightsail box.
USE_MEMORY_DB=true

# Which board the in-memory desk seeds. Default: the finals board (15
# technicians, two days) dated today in Singapore. `eastwind` is the 12-job
# test fixture on its fixed date. BOARD_DATE=YYYY-MM-DD pins the day.
# DEMO_SCENARIO=eastwind
# BOARD_DATE=

# Organiser LLM gateway (server-side only). Claude Sonnet 4.5.
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Postgres (docker compose default). Used when USE_MEMORY_DB=false.
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch

# Optimizer sidecar.
OPTIMIZER_URL=http://localhost:8081

# Caddy. ":80" locally; on the box a hostname, e.g. 54.179.142.4.sslip.io
SITE_ADDRESS=:80
